# Copy to .env.local (already gitignored) and fill in real values.
# First env file in this repo — see specs/011.

# Required. Signs/encrypts the session cookie (lib/auth/session.ts).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Overrides the default SQLite file location (./data/app.db).
# DATABASE_FILE_PATH=./data/app.db

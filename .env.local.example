# Copy to .env.local (already gitignored) and fill in real values.
# First env file in this repo — see specs/011.

# Required. Signs/encrypts the session cookie (lib/auth/session.ts).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Overrides the default local SQLite file location (./data/app.db).
# Ignored once TURSO_DATABASE_URL is set.
# DATABASE_FILE_PATH=./data/app.db

# Required in production (e.g. Vercel) — a local file has no persistent,
# writable filesystem there. Get these from `turso db show <name> --url`
# and `turso db tokens create <name>`. Leave both unset for local dev,
# which falls back to the SQLite file above.
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=
